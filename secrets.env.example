# Copy to secrets.env (gitignored) and fill in whatever repository variables
# the step you're running actually needs. run.sh sources this file if present,
# then forwards -e VAR=value into the agent container for every variable
# defined below that ends up non-empty -- same as how an unset Bitbucket
# repository variable behaves. The tool has no fixed idea of which variable
# names matter; it just forwards whatever you declare here, by name.
#
# Example (uncomment/rename for your project's own pipeline variables --
# registry credentials, deploy keys, database passwords, API tokens, etc):
# DOCKER_REGISTRY_KEY_JSON=
# SSH_PRIVATE_KEY_BASE64=
# DATABASE_PASSWORD=

# KEEP=1   # leave the dind sidecar + network running after the agent exits
#          # (faster repeat runs; clean up later with ./run.sh --clean)
